# Sync-Token: client muss denselben Wert senden (Authorization: Bearer <TOKEN>).
# Bitte ZUFÄLLIGEN Wert erzeugen, z.B.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=change-me-to-a-long-random-string

# SQLite-Datei (relativ zum data-volume-mount). Default: data/todonotes.db
DB_PATH=data/todonotes.db
