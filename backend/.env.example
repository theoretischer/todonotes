# Sync-Token: Static-Secret für Übergangs-Compat (alte Android-App).
# Kann nach Migration auf account-basierte Auth geleert/entfernt werden.
# Bitte ZUFÄLLIGEN Wert erzeugen, z.B.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=change-me-to-a-long-random-string

# SQLite-Datei (relativ zum data-volume-mount). Default: data/todonotes.db
DB_PATH=data/todonotes.db

# Statische Web-Files (kompilierte Wasm-App, gefüllt in Phase M9).
# Wenn das Verzeichnis existiert, wird es unter / ausgeliefert.
WEB_DIR=data/web
